// Prisma schema for shared-db-shared-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  tenant_id   String   @id @default(uuid())
  name        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  user_id    String   @id @default(uuid())
  email      String   @unique
  name       String
  password   String
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [tenant_id])
  contacts   Contact[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Contact {
  contact_id String   @id @default(uuid())
  name       String
  email      String
  userId     String
  user       User     @relation(fields: [userId], references: [user_id])
  tenantId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
} 