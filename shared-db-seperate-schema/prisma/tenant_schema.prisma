// tenant_schema.prisma
model User {
  user_id    String   @id @default(uuid())
  email      String   @unique
  name       String
  password   String
  contacts   Contact[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Contact {
  contact_id String   @id @default(uuid())
  name       String
  email      String
  userId     String
  user       User     @relation(fields: [userId], references: [user_id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
} 